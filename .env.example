# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=text2image_db
DB_USER=postgres
DB_PASSWORD=your_password

# 日志级别
LOG_LEVEL=INFO

# 可选：自定义Hugging Face缓存目录
# HF_HOME=/path/to/your/huggingface/cache

# 可选：自定义图片输出目录
# DEFAULT_OUTPUT_DIR=/path/to/your/images

# 可选：GPU配置 (如果有支持的GPU)
# DEVICE=cuda  # 或 mps (Apple Silicon) 或 cpu