# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_downloader
DB_USER=postgres
DB_PASSWORD=your_password

# Server Configuration
PORT=3000

# Notification Configuration (WxPusher)
WXPUSHER_TOKEN=your_wxpusher_token
